# Copy to .env.host on the server and replace every CHANGE_ME value.
# Never commit .env.host.
GLC_SITE_URL=https://geo-lander.com
GLC_HOST_LOOPBACK_PORT=8080

MARIADB_DATABASE=geolander
MARIADB_USER=geolander
MARIADB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

# Cloudflare Tunnel token from Zero Trust > Networks > Tunnels.
# This is not the same as a Cloudflare API token.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN

# Public identifiers used by the protected agent API.
GLC_CF_ACCESS_TEAM_DOMAIN=jolly-sound-4ff2.cloudflareaccess.com
GLC_CF_ACCESS_AUD=c15457d8a5194a5ace5568d2fed63be5f66e9b5d6c58aaa501d386ce880374da

# Generate a new Ed25519 secret for this deployment; never reuse a key from
# the previously compromised environment.
GLC_WEB_BOT_AUTH_PRIVATE_KEY=CHANGE_ME_BASE64_ED25519_SECRET_KEY

# Optional transactional email. Leave all values empty until the sending
# domain has valid SPF/DKIM and the provider credentials are available.
GLC_SMTP_HOST=
GLC_SMTP_PORT=587
GLC_SMTP_USERNAME=
GLC_SMTP_PASSWORD=
GLC_SMTP_ENCRYPTION=tls
GLC_SMTP_FROM=info@geo-lander.com
